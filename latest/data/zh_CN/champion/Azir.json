full":"AzirR.png","sprite":"spell2.png","group":"spell","x":432,"y":0,"w":48,"h":48},"resource":"{{ cost }} {{ abilityresourcename }}"}],"passive":{"name":"恕瑞玛的传承","description":"阿兹尔可以从友方或敌方防御塔的废墟中召唤太阳圆盘。","image":{"full":"Azir_Passive.png","sprite":"passive0.png","group":"passive","x":144,"y":48,"w":48,"h":48}},"recommended":[]}}}