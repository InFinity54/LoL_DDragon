x":48,"y":96,"w":48,"h":48},"resource":"{{ cost }} {{ abilityresourcename }}"}],"passive":{"name":"護國意志","description":"每過幾秒加里歐下一次的普攻即可對範圍內敵人造成魔法傷害。","image":{"full":"Galio_Passive.png","sprite":"passive1.png","group":"passive","x":288,"y":0,"w":48,"h":48}},"recommended":[]}}}